{
  "name": "mission-minded-worldwide",
  "productName": "Mission Minded",
  "version": "0.0.4",
  "description": "Mission Minded Worldwide \u2014 offline-first patient records for free dental, medical and vision clinics.",
  "author": {
    "name": "Mission Minded Worldwide",
    "email": "info@missionmindedworldwide.org"
  },
  "license": "UNLICENSED",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "jsdom": "^30.0.1"
  },
  "build": {
    "appId": "org.missionmindedworldwide.clinic",
    "productName": "Mission Minded",
    "copyright": "Copyright \u00a9 2026 Mission Minded Worldwide",
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "oofski",
        "repo": "MissionMindedWorldwide"
      }
    ],
    "files": [
      "src/**/*",
      "assets/**/*",
      "!**/*.map"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Mission Minded",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "MMW-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "MMW-Portable-${version}.${ext}"
    }
  }
}
